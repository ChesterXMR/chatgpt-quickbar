{
  "manifest_version": 3,
  "name": "ChatGPT Quick Bar",
  "version": "1.1.0",
  "description": "Adds Instant / Medium / High effort and Web / Image toggles above the ChatGPT composer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
